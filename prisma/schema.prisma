generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  password      String
  role          String            @default("STUDENT")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assignments   Assignment[]      @relation("TeacherAssignments")
  submissions   Submission[]
  codes         InvitationCode[]  @relation("CodeCreator")
}

model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String
  modelAnswer String
  dueDate     DateTime?
  totalMarks  Int          @default(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teacherId   String
  teacher     User         @relation("TeacherAssignments", fields: [teacherId], references: [id])
  submissions Submission[]
}

model Submission {
  id              String     @id @default(cuid())
  content         String
  fileName        String
  fileType        String
  autoGrade       Int?
  autoFeedback    String?
  teacherGrade    Int?
  teacherFeedback String?
  assignmentId    String
  studentId       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         User       @relation(fields: [studentId], references: [id])
}

model InvitationCode {
  id          String   @id @default(cuid())
  code        String   @unique
  isActive    Boolean  @default(true)
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  creator     User     @relation("CodeCreator", fields: [createdBy], references: [id])
}